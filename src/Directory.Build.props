<Project>

    <PropertyGroup>
        <Version>2.9.7</Version>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <NoWarn>CA1031;CS1591;NU1507;CA1416;IDE0058;IDE0053;IDE0200</NoWarn>
        <Nullable>annotations</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>COLITU LIMITED</Authors>
        <Company>COLITU LIMITED</Company>
        <Product>Colitu VPN</Product>
        <AssemblyTitle>Colitu VPN</AssemblyTitle>
        <Description>Colitu VPN Windows App</Description>
        <PackageLicenseExpression>GPL-3.0</PackageLicenseExpression>
        <!-- A fixed year, not the build clock: the same commit must give the same binaries
             (reproducible builds). Move it forward in the first release of a new year. -->
        <ColituCopyrightYear>2026</ColituCopyrightYear>
        <Copyright>Copyright © 2017-$(ColituCopyrightYear) 2dust and the v2rayN contributors; Copyright © $(ColituCopyrightYear) COLITU LIMITED</Copyright>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <!-- Reproducible builds: every resolved package (transitive ones too) and its content hash is
         recorded in packages.lock.json. CI restores in locked mode and fails on any drift; after a
         package change run `dotnet restore` (with the nuget.org source) and commit the lock files. -->
    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
        <!-- Restore must see the same inputs for build, test and `publish -r win-x64`, or the lock
             files would not match: the runtime the installer ships, and the ILLink pack that
             single-file publishing (Release) pulls in, for every configuration. -->
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <EventSourceSupport>false</EventSourceSupport>
        <StackTraceSupport>false</StackTraceSupport>
        <MetricsSupport>false</MetricsSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>

        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>
        <!-- Stack traces in logs (and in logs attached to support requests) show src/... instead of
             the build machine's folder. -->
        <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=src\</PathMap>
    </PropertyGroup>
</Project>
